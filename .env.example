# Copy to .env and fill in. .env is gitignored.

# Which provider handles answer generation. Embeddings are always local and free,
# so this is the only thing that ever costs money (or nothing, on a free tier).
#   gemini     free tier — get a key at https://aistudio.google.com/apikey
#   anthropic  paid, best quality — https://console.anthropic.com
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...

# Model overrides. Leave blank to use the provider's default:
#   gemini     -> gemini-flash-lite-latest  (gemini-flash-latest has a
#                 20-requests/day free quota — confirmed by hitting it)
#   anthropic  -> claude-opus-5
# Use gemini-pro-latest for better character extraction if your quota allows it.
# ANSWER_MODEL=
# EXTRACTION_MODEL=

# Retrieval
TOP_K=6

# Web search tool for the Ask agent (build-order step 3). Free tier:
# 1000 searches/month. Get a key at https://app.tavily.com — leave blank and
# the agent just won't have the option to search the web.
TAVILY_API_KEY=
