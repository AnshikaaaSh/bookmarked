# Copy to .env and fill in. .env is gitignored.

# Which provider handles answer generation. Embeddings are always local and free,
# so this is the only thing that ever costs money (or nothing, on a free tier).
#   gemini     free tier — get a key at https://aistudio.google.com/apikey
#   groq       free tier, different infra than Google — tested as a Gemini
#              fallback and NOT a clean win: Recommend structurally exceeds
#              Groq's 8000 tokens/minute free-tier cap on a single request,
#              regardless of model or timing, so it just doesn't work there
#              right now. Ask is the most likely to actually fit.
#              Get a key at https://console.groq.com/keys
#   anthropic  paid, best quality — https://console.anthropic.com
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...

# Model overrides. Leave blank to use the provider's default:
#   gemini     -> gemini-flash-lite-latest  (gemini-flash-latest has a
#                 20-requests/day free quota — confirmed by hitting it)
#   groq       -> openai/gpt-oss-120b — verify with `check_llm --list`,
#                 Groq's catalog changes over time same as Gemini's dated
#                 names. See the LLM_PROVIDER comment above for why this
#                 isn't a clean substitute — Gemini stays the default.
#   anthropic  -> claude-opus-5
# Use gemini-pro-latest for better character extraction if your quota allows it.
# ANSWER_MODEL=
# EXTRACTION_MODEL=

# Per-call timeout/retries for the interactive path (Ask, Recommend, Write).
# Worst case per call is roughly TIMEOUT_S * (MAX_RETRIES + 1). Defaults (12s,
# 1 retry -> ~24s worst case) already fail fast rather than hang; lower
# further if a provider is visibly degraded and you'd rather get a quick
# error than wait out a slow response that might still succeed.
# MODEL_TIMEOUT_S=12
# MODEL_MAX_RETRIES=1

# Extraction gets its own, more patient budget — it's a background job
# (NFR6 allows this to be slow) sending a whole book in one call, which
# genuinely takes longer than an interactive turn. Don't lower this to match
# MODEL_TIMEOUT_S — that cuts extraction off mid-generation, not just on a
# dead connection (a smaller book can fail while a bigger one succeeds).
# EXTRACTION_TIMEOUT_S=90
# EXTRACTION_MAX_RETRIES=2

# Retrieval
TOP_K=6

# Web search tool for the Ask agent (build-order step 3). Free tier:
# 1000 searches/month. Get a key at https://app.tavily.com — leave blank and
# the agent just won't have the option to search the web.
TAVILY_API_KEY=
